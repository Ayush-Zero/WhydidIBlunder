# The browser's API prefix. Dev uses Vite's same-origin proxy; leave this as
# /api. A split deployment can set an absolute URL, e.g.
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api and /health. This is read by
# vite.config.ts in Node and is never sent to the browser.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
