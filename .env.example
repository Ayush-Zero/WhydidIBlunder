# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ---- Paths ----
# Windows local dev (the .exe you downloaded). In Docker this becomes
# /usr/local/bin/stockfish.
STOCKFISH_PATH=C:\Tools\stockfish\stockfish.exe

# ---- Database ----
# SQLite for v1 (no server to run). Path relative to the worker's cwd.
DATABASE_URL=sqlite:///./data/whydidiblunder.db
# Simpler alternative; wins over DATABASE_URL when set.
# DB_PATH=./data/whydidiblunder.db

# ---- Analysis tuning ----
ANALYSIS_DEPTH=20
ANALYSIS_MULTIPV=4
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=256
# Quick first pass; large-swing moves get re-searched deeper (adaptive depth)
ANALYSIS_QUICK_DEPTH=14
ANALYSIS_DEEP_DEPTH=24

# ---- Position cache (Phase 2 B1) ----
# OFF unless set. Caching is a correctness-bearing optimisation (a wrong key
# serves the wrong evaluation forever), so it is enabled deliberately rather
# than inherited from a fresh checkout. Empty/unset = no caching.
CACHE_DIR=./data/position_cache

# ---- Classification thresholds (Phase 1; win%-points of drop) ----
# drop >= THRESHOLD_INACCURACY -> inaccuracy, etc. Must stay ordered.
# Defaults (10/20/30) come from analyzer/winpct.py; set these only to tune.
THRESHOLD_INACCURACY=10
THRESHOLD_MISTAKE=20
THRESHOLD_BLUNDER=30
# Gap to the engine's best line (win%-points) that is never flagged.
SUPPRESS_WIN_PTS=0.2

# ---- Chess.com API ----
# No key needed. Just be polite: cache and rate-limit.
CHESSCOM_API_BASE=https://api.chess.com/pub
# Where cached API responses live. Past months are immutable so they are only
# fetched once; delete the directory to force a refetch. Empty = no caching.
CHESSCOM_CACHE_DIR=./data/chesscom_cache

# ---- LLM explanations (Phase 5, backend only) ----
# Leave blank until you build the explanation layer.
LLM_API_KEY=
LLM_MODEL=

# ---- Server ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Where `python -m server.main` listens. In Docker the host must be 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000

# ---- Limits ----
RATE_LIMIT_ANALYSES_PER_HOUR=5
JOB_TIMEOUT_SECONDS=180
# How often the reaper (B4) sweeps for stale running jobs.
REAPER_INTERVAL_SECONDS=30
